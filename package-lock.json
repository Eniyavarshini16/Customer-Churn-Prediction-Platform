# ===== Server =====
server.port=8080

# ===== MySQL Datasource =====
# Create the database first: CREATE DATABASE churn_db;
spring.datasource.url=jdbc:mysql://localhost:3306/churn_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=root
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===== JPA / Hibernate =====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# ===== App-specific settings =====
# Number of synthetic customer records to generate on first startup if DB is empty
app.seed.customer-count=800
# Where the trained Weka model is persisted on disk
app.ml.model-path=churn-rf-model.model
# Retrain automatically on startup if no model file exists yet
app.ml.train-on-startup=true

# Risk thresholds (churn probability)
app.risk.medium-threshold=0.30
app.risk.high-threshold=0.60
